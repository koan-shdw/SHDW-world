{
  "name": "shdw-world-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/regression.cjs",
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build && node tests/build-output.cjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:worker": "tsc --noEmit --strict --target ES2022 --module ESNext --moduleResolution bundler --resolveJsonModule --lib ES2022,WebWorker --skipLibCheck ../worker/src/index.ts"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "svelte": "^5.57.0",
    "three": "^0.180.0",
    "three-mesh-bvh": "^0.9.14",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tweakpane/core": "^2.0.5",
    "@types/three": "^0.180.0",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
